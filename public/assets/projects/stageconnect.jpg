<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#18191b" />
      <stop offset="50%" stop-color="#131314" />
      <stop offset="100%" stop-color="#0a0a0c" />
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.4"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="30" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Background -->
  <rect width="800" height="600" fill="url(#bgGrad)" />

  <!-- Dotted grid -->
  <pattern id="grid" width="24" height="24" patternUnits="userSpaceOnUse">
    <circle cx="2" cy="2" r="1" fill="#3c4043" opacity="0.4" />
  </pattern>
  <rect width="800" height="600" fill="url(#grid)" />

  <!-- Ambient glow orb -->
  <circle cx="400" cy="250" r="180" fill="#3b82f6" opacity="0.12" filter="url(#glow)" />

  <!-- Browser/Window Mockup Container -->
  <rect x="50" y="40" width="700" height="520" rx="16" fill="#1e1f20" stroke="#3c4043" stroke-width="2" />

  <!-- Window Header -->
  <rect x="50" y="40" width="700" height="42" rx="16" fill="#282a2c" />
  <rect x="50" y="70" width="700" height="12" fill="#282a2c" />
  <circle cx="75" cy="61" r="5" fill="#ea4335" />
  <circle cx="95" cy="61" r="5" fill="#fbbc05" />
  <circle cx="115" cy="61" r="5" fill="#34a853" />

  <!-- Address Pill -->
  <rect x="220" y="49" width="360" height="24" rx="12" fill="#18191b" stroke="#3c4043" stroke-width="1" />
  <text x="400" y="65" fill="#9aa0a6" font-family="-apple-system, sans-serif" font-size="11" text-anchor="middle">
    stageconnect.app/workspace
  </text>

  <!-- Visual content inside mockup -->
  <g transform="translate(70, 100)">
    <!-- Badge -->
    <rect x="0" y="0" width="160" height="26" rx="6" fill="#18191b" stroke="#3b82f6" stroke-width="1" />
    <text x="80" y="17" fill="#3b82f6" font-family="monospace" font-size="11" font-weight="bold" text-anchor="middle">
      STAGE: PRE-LAUNCH (WAITLIST)
    </text>

    <!-- Main Title -->
    <text x="0" y="55" fill="#ffffff" font-family="-apple-system, sans-serif" font-size="24" font-weight="bold">
      StageConnect
    </text>

    <!-- Subtitle -->
    <text x="0" y="80" fill="#9aa0a6" font-family="-apple-system, sans-serif" font-size="13">
      B2B Marketplace for Live-Performance Talent
    </text>

    <!-- Inner UI Graphic elements -->
    
  <g transform="translate(0, 110)">
    <rect x="0" y="0" width="200" height="280" rx="12" fill="#18191b" stroke="#3c4043" />
    <rect x="15" y="15" width="170" height="120" rx="8" fill="#282a2c" />
    <circle cx="100" cy="75" r="24" fill="#3b82f6" opacity="0.8" />
    <polygon points="94,65 110,75 94,85" fill="#ffffff" />
    <text x="15" y="160" fill="#ffffff" font-family="-apple-system, sans-serif" font-size="13" font-weight="bold">Live Audition Reel</text>
    <text x="15" y="180" fill="#9aa0a6" font-family="-apple-system, sans-serif" font-size="11">Verified Theater Artist</text>
    <rect x="15" y="200" width="70" height="20" rx="4" fill="#065f46" />
    <text x="50" y="214" fill="#34d399" font-family="monospace" font-size="9" text-anchor="middle">VERIFIED</text>
    <rect x="15" y="235" width="170" height="28" rx="6" fill="#2563eb" />
    <text x="100" y="253" fill="#ffffff" font-family="-apple-system, sans-serif" font-size="11" font-weight="bold" text-anchor="middle">Book Performer</text>

    <!-- Center Feed -->
    <rect x="220" y="0" width="440" height="280" rx="12" fill="#18191b" stroke="#3c4043" />
    <text x="240" y="32" fill="#ffffff" font-family="-apple-system, sans-serif" font-size="14" font-weight="bold">Candidate Matching Algorithm</text>
    <text x="240" y="52" fill="#9aa0a6" font-family="-apple-system, sans-serif" font-size="11">Active Waitlist: ~500 Artists &amp; 25–30 Brands</text>
    
    <!-- Item 1 -->
    <rect x="240" y="70" width="400" height="54" rx="8" fill="#282a2c" />
    <circle cx="265" cy="97" r="16" fill="#3b82f6" />
    <text x="295" y="93" fill="#ffffff" font-family="-apple-system, sans-serif" font-size="12" font-weight="bold">Mumbai Stage Production · Lead Role</text>
    <text x="295" y="110" fill="#9aa0a6" font-family="-apple-system, sans-serif" font-size="10">Escrow Contract Backed · 98% Match</text>

    <!-- Item 2 -->
    <rect x="240" y="135" width="400" height="54" rx="8" fill="#282a2c" />
    <circle cx="265" cy="162" r="16" fill="#8b5cf6" />
    <text x="295" y="158" fill="#ffffff" font-family="-apple-system, sans-serif" font-size="12" font-weight="bold">Commercial Ad Campaign · Classical Dance</text>
    <text x="295" y="175" fill="#9aa0a6" font-family="-apple-system, sans-serif" font-size="10">Direct Agency Inbound · 94% Match</text>

    <!-- Stats row -->
    <rect x="240" y="200" width="190" height="65" rx="8" fill="#141517" stroke="#282a2c" />
    <text x="255" y="224" fill="#9aa0a6" font-family="monospace" font-size="10">WAITLIST PIPELINE</text>
    <text x="255" y="250" fill="#34d399" font-family="monospace" font-size="18" font-weight="bold">~500 Users</text>

    <rect x="450" y="200" width="190" height="65" rx="8" fill="#141517" stroke="#282a2c" />
    <text x="465" y="224" fill="#9aa0a6" font-family="monospace" font-size="10">CONFIRMED BRANDS</text>
    <text x="465" y="250" fill="#60a5fa" font-family="monospace" font-size="18" font-weight="bold">25–30 Brands</text>
  </g>

  </g>
</svg>