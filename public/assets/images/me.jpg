<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 750" width="100%" height="100%">
  <defs>
    <linearGradient id="pGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e2024" />
      <stop offset="50%" stop-color="#141517" />
      <stop offset="100%" stop-color="#0a0a0c" />
    </linearGradient>
    <linearGradient id="orbGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3b82f6" />
      <stop offset="100%" stop-color="#8b5cf6" />
    </linearGradient>
  </defs>

  <rect width="600" height="750" fill="url(#pGrad)" />

  <!-- Dotted grid -->
  <pattern id="pGrid" width="24" height="24" patternUnits="userSpaceOnUse">
    <circle cx="2" cy="2" r="1" fill="#3c4043" opacity="0.3" />
  </pattern>
  <rect width="600" height="750" fill="url(#pGrid)" />

  <!-- Soft spotlight -->
  <circle cx="300" cy="300" r="220" fill="#3b82f6" opacity="0.15" />

  <!-- Stylized Portrait Silhouette / Avatar -->
  <g transform="translate(300, 310)">
    <!-- Base Glow Circle -->
    <circle cx="0" cy="0" r="140" fill="#282a2c" stroke="#3c4043" stroke-width="3" />
    <circle cx="0" cy="0" r="132" fill="url(#orbGrad)" opacity="0.15" />

    <!-- Head -->
    <circle cx="0" cy="-35" r="55" fill="#4285f4" opacity="0.9" />

    <!-- Shoulders -->
    <path d="M -95 105 C -95 45, 95 45, 95 105 Z" fill="#4285f4" opacity="0.85" />

    <!-- Stylized glasses / tech look -->
    <rect x="-35" y="-45" width="28" height="18" rx="4" fill="#ffffff" opacity="0.95" />
    <rect x="7" y="-45" width="28" height="18" rx="4" fill="#ffffff" opacity="0.95" />
    <line x1="-7" y1="-36" x2="7" y2="-36" stroke="#ffffff" stroke-width="3" />
  </g>

  <!-- Card Info Footer -->
  <g transform="translate(300, 560)">
    <rect x="-180" y="0" width="360" height="130" rx="16" fill="#18191b" stroke="#3c4043" stroke-width="1.5" />
    <text x="0" y="38" fill="#ffffff" font-family="-apple-system, sans-serif" font-size="20" font-weight="bold" text-anchor="middle">
      Ojasvi Kathuria
    </text>
    <text x="0" y="66" fill="#9aa0a6" font-family="-apple-system, sans-serif" font-size="12" text-anchor="middle">
      B.Tech CS &amp; Business Systems · VIT '27
    </text>
    <rect x="-110" y="85" width="220" height="26" rx="13" fill="#1e1f20" stroke="#3b82f6" stroke-width="1" />
    <text x="0" y="102" fill="#60a5fa" font-family="monospace" font-size="11" font-weight="bold" text-anchor="middle">
      AWS Certified AI Practitioner
    </text>
  </g>
</svg>